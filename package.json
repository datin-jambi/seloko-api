{
  "name": "seloko-api",
  "version": "1.0.0",
  "description": "SELOKO Centralized Core API — Bapenda Jambi",
  "author": "Bapenda Jambi",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker:audit": "tsx watch --env-file-if-exists=.env src/workers/consumers/audit.consumer.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset --force --skip-seed",
    "db:migrate:reset:seed": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:reset": "tsx prisma/seed.ts --reset",
    "db:smoke": "bash prisma/seed-data/smoke.sh",
    "db:smoke:applications": "bash prisma/seed-data/applications.smoke.sh",
    "db:smoke:me-applications": "bash prisma/seed-data/me-applications.smoke.sh",
    "db:smoke:roles": "bash prisma/seed-data/roles.smoke.sh",
    "db:smoke:roles-cache": "bash prisma/seed-data/roles-cache.smoke.sh",
    "db:check:menus": "tsx prisma/seed-data/menus.check.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project prisma/tsconfig.json",
    "test": "tsx --env-file-if-exists=.env src/modules/core/auth/auth.check.ts && tsx --env-file-if-exists=.env src/common/utils/utils.check.ts && tsx src/config/redis.check.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11",
    "@fastify/cors": "^10",
    "@fastify/jwt": "^9",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6",
    "amqplib": "^0.10",
    "argon2": "^0.43",
    "fastify": "^5",
    "fastify-plugin": "^5",
    "fastify-type-provider-zod": "^4",
    "ioredis": "^5",
    "prisma": "^6",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10",
    "@types/node": "^22",
    "pino-pretty": "^13",
    "tsc-alias": "^1.9.5",
    "tsx": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.43.1": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
