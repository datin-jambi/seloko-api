// ─── Prisma Schema ─────────────────────────────────────────────────────────────
// SELOKO API — Bapenda Provinsi Jambi
// Multi-Application Centralized RBAC.
//
// Bentuk tabel & kolom mengikuti referensi SQL (snake_case, uuid VARCHAR(36)),
// dengan tiga tambahan yang dibutuhkan kode berjalan:
//   1. multi-role per aplikasi  → unique (user, app, role), bukan (user, app)
//   2. refresh_tokens           → rotasi JWT
//   3. audit_logs               → jejak audit asinkron via RabbitMQ
// ────────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Applications ──────────────────────────────────────────────────────────────
/// Aplikasi terdaftar di ekosistem SELOKO — internal maupun publik.
/// `code` dipakai pada header X-App-Code.
model Application {
  id             String   @id @default(uuid(7)) @db.VarChar(36)
  code           String   @unique @db.VarChar(50) // 'seloko', 'lapak-jambi-web', …
  name           String   @db.VarChar(100)
  description    String?
  /// Alamat pangkal aplikasi — menu dengan path relatif digabung ke sini.
  /// 'https://lapak.jambiprov.go.id' + '/cms/produk'
  baseUrl        String?  @map("base_url") @db.VarChar(255)
  /// Nama ikon aplikasi di launcher super app (kunci icon set front-end).
  icon           String?  @db.VarChar(50)
  /// Siapa yang boleh login: INTERNAL (pegawai, lewat seloko) atau PUBLIC
  /// (warga). Tidak dapat diubah setelah dibuat — akun yang sudah terdaftar
  /// akan terdampar di aplikasi yang tiba-tiba berganti jenis.
  audience       Audience @default(INTERNAL)
  tagline        String?  @db.VarChar(150)
  logoUrl        String?  @map("logo_url") @db.VarChar(255)
  logoFileId     String?  @map("logo_file_id") @db.VarChar(100)
  logoDarkUrl    String?  @map("logo_dark_url") @db.VarChar(255)
  logoDarkFileId String?  @map("logo_dark_file_id") @db.VarChar(100)
  faviconUrl     String?  @map("favicon_url") @db.VarChar(255)
  faviconFileId  String?  @map("favicon_file_id") @db.VarChar(100)
  ogImageUrl     String?  @map("og_image_url") @db.VarChar(255)
  ogImageFileId  String?  @map("og_image_file_id") @db.VarChar(100)
  /// Konfigurasi tampilan yang hanya dibaca front-end: { contact, seo, features, legal }.
  /// Bentuknya divalidasi Zod di modul applications, bukan di DB.
  settings       Json     @default("{}")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  permissions       Permission[]
  roles             Role[]
  userAppRoles      UserAppRole[]
  menuItems         MenuItem[]
  articleCategories ArticleCategory[]
  articles          Article[]
  banners           Banner[]
  galleries         Gallery[]
  pages             Page[]
  regulations       Regulation[]
  faqCategories     FaqCategory[]
  faqs              Faq[]
  lapakCategories   LapakCategory[]
  lapakProducts     LapakProduct[]
  lapakCarts        LapakCart[]
  lapakOrders       LapakOrder[]
  lapakSkrdSettings LapakSkrdSetting[]

  @@map("applications")
}

// ─── Menu Items (Sidebar) ──────────────────────────────────────────────────────
/// Satu baris sidebar milik satu aplikasi. Hirarki lewat parentId — parent
/// biasanya tanpa path (hanya pembuka grup), child yang punya alamat.
///
/// Visibilitas berlapis, dievaluasi dari yang paling longgar:
///   1. isActive          — mematikan item untuk semua orang
///   2. permissionId null — tidak butuh izin; terisi → hanya pemegang izin itu
///   3. menuRoles kosong  — berlaku untuk semua role di aplikasi;
///                          terisi → hanya role yang terdaftar
/// Super admin melewati lapis 2 dan 3, sama seperti requirePermission.
model MenuItem {
  id            String   @id @default(uuid(7)) @db.VarChar(36)
  applicationId String   @map("app_id") @db.VarChar(36)
  parentId      String?  @map("parent_id") @db.VarChar(36)
  /// Kunci stabil dalam lingkup aplikasi, mis. 'pengguna', 'akses.role'.
  /// Dipakai seeder untuk upsert dan oleh front-end untuk menandai menu aktif —
  /// label boleh berubah tanpa memutus referensi.
  code          String   @db.VarChar(100)
  /// Label yang tampil di sidebar — bahasa Indonesia.
  label         String   @db.VarChar(100)
  /// Nama ikon (kunci icon set front-end, mis. 'users', 'file-text').
  icon          String?  @db.VarChar(50)
  /// Alamat tujuan. Relatif ('/cms/produk') digabung dengan Application.baseUrl;
  /// absolut ('https://…') dipakai apa adanya. Null = parent grup saja.
  path          String?  @db.VarChar(255)
  /// Buka di tab baru — dipakai untuk tautan ke aplikasi lain.
  isExternal    Boolean  @default(false) @map("is_external")
  /// Urutan tampil di antara saudara sekandung.
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  /// Izin yang harus dipegang agar item tampil. Null = bebas izin.
  permissionId  String?  @map("permission_id") @db.VarChar(36)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  parent      MenuItem?   @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    MenuItem[]  @relation("MenuItemTree")
  permission  Permission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)
  menuRoles   MenuRole[]

  @@unique([applicationId, code], map: "uq_app_menu_code")
  @@index([applicationId, parentId, sortOrder], map: "idx_menu_items_app_parent_order")
  @@index([parentId], map: "idx_menu_items_parent")
  @@index([permissionId], map: "idx_menu_items_permission")
  @@map("menu_items")
}

// ─── Menu Roles (Pivot) ────────────────────────────────────────────────────────
/// Pembatas opsional: item hanya tampil untuk role yang terdaftar di sini.
/// Tanpa baris sama sekali, item berlaku untuk seluruh role di aplikasinya.
model MenuRole {
  menuItemId String @map("menu_item_id") @db.VarChar(36)
  roleId     String @map("role_id") @db.VarChar(36)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([menuItemId, roleId])
  @@index([roleId], map: "idx_menu_roles_role")
  @@map("menu_roles")
}

// ─── Permissions ───────────────────────────────────────────────────────────────
/// Aksi spesifik dalam lingkup satu aplikasi.
/// `code` adalah kunci otoritatif yang dicek guard: "user:read", "product:approve".
/// `module` hanya pengelompokan untuk tampilan CMS.
model Permission {
  id            String   @id @default(uuid(7)) @db.VarChar(36)
  applicationId String   @map("app_id") @db.VarChar(36)
  code          String   @db.VarChar(100) // 'user:read'
  name          String   @db.VarChar(150) // 'Melihat Daftar Pengguna'
  module        String   @db.VarChar(50) // 'User', 'Produk', 'Banner'
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  menuItems       MenuItem[]

  @@unique([applicationId, code], map: "uq_app_permission")
  @@index([applicationId], map: "idx_permissions_app_id")
  @@map("permissions")
}

// ─── Roles ─────────────────────────────────────────────────────────────────────
/// Jabatan akses spesifik per aplikasi. Bukan enum — murni data.
model Role {
  id            String   @id @default(uuid(7)) @db.VarChar(36)
  applicationId String   @map("app_id") @db.VarChar(36)
  name          String   @db.VarChar(50) // 'superadmin', 'editor', 'verifikator'
  description   String?
  /// Jenis akun yang boleh memegang role ini. Satu aplikasi publik bisa punya
  /// role INTERNAL (verifikator, dipakai pegawai lewat seloko) dan PUBLIC
  /// (pedagang) sekaligus. Tidak dapat diubah setelah dibuat.
  audience      Audience @default(INTERNAL)
  /// Role bawaan sistem — tidak boleh dihapus lewat CMS.
  isSystemRole  Boolean  @default(false) @map("is_system_role")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userAppRoles    UserAppRole[]
  menuRoles       MenuRole[]

  @@unique([applicationId, name], map: "uq_app_role_name")
  @@index([applicationId], map: "idx_roles_app_id")
  @@map("roles")
}

// ─── Role Permissions (Pivot) ──────────────────────────────────────────────────
model RolePermission {
  roleId       String @map("role_id") @db.VarChar(36)
  permissionId String @map("permission_id") @db.VarChar(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Users ─────────────────────────────────────────────────────────────────────
/// Identitas tunggal untuk seluruh ekosistem. Role diberikan per aplikasi
/// lewat user_app_roles — tidak ada kolom role di sini.
model User {
  id              String    @id @default(uuid(7)) @db.VarChar(36)
  /// NIP ASN/pegawai — kosong untuk pengguna non-ASN.
  nip             String?   @unique @db.VarChar(30)
  /// INTERNAL = pegawai (login hanya lewat aplikasi INTERNAL, yaitu seloko);
  /// PUBLIC = warga (login di aplikasi publik). Satu orang yang juga belanja di
  /// lapak memiliki DUA baris dengan email sama — keduanya tidak pernah bercampur.
  accountType     Audience  @default(INTERNAL) @map("account_type")
  /// Wajib untuk INTERNAL (login email/username), null untuk PUBLIC (email saja).
  username        String?   @unique @db.VarChar(50)
  email           String    @db.VarChar(100)
  fullName        String    @map("full_name") @db.VarChar(150)
  phoneNumber     String?   @map("phone_number") @db.VarChar(20)
  /// NIK warga — opsional, tapi bila diisi harus unik (satu orang satu akun
  /// publik). PII: dimasking di log & daftar, lihat security-guidelines.
  nik             String?   @unique @db.VarChar(16)
  passwordHash    String    @map("password_hash") @db.VarChar(255) // Argon2id
  avatarUrl       String?   @map("avatar_url")
  avatarFileId    String?   @map("avatar_file_id") @db.VarChar(100)
  /// Melewati SELURUH pengecekan permission di semua aplikasi.
  isSuperAdmin    Boolean   @default(false) @map("is_super_admin")
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz()
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz() // Soft delete

  userAppRoles      UserAppRole[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  articlesAuthored  Article[]
  galleriesAuthored Gallery[]
  faqsAuthored      Faq[]                @relation("FaqAuthor")
  faqsUpdated       Faq[]                @relation("FaqUpdatedBy")
  vehicleTaxChecks  VehicleTaxCheckLog[]
  lapakCarts        LapakCart[]
  lapakOrders       LapakOrder[]

  @@unique([accountType, email], map: "uq_users_account_email")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

/// Pemisah dunia pegawai dan warga — dipakai untuk akun, aplikasi, dan role.
enum Audience {
  INTERNAL
  PUBLIC

  @@map("audience")
}

// ─── User App Roles (Pivot) ────────────────────────────────────────────────────
/// Inti multi-aplikasi: satu user boleh punya BEBERAPA role di tiap aplikasi.
/// (Referensi membatasi satu role per aplikasi; di sini sengaja dilonggarkan
/// agar mis. seorang verifikator juga bisa merangkap editor.)
model UserAppRole {
  id            String    @id @default(uuid(7)) @db.VarChar(36)
  userId        String    @map("user_id") @db.VarChar(36)
  applicationId String    @map("app_id") @db.VarChar(36)
  roleId        String    @map("role_id") @db.VarChar(36)
  /// userId admin yang menugaskan.
  assignedBy    String?   @map("assigned_by") @db.VarChar(36)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  /// Penugasan berbatas waktu — null berarti permanen.
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz()

  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application               @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  role          Role                      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// Lingkup OPD penugasan ini. Kosong = seluruh OPD (level Bapenda).
  organizations UserAppRoleOrganization[]

  @@unique([userId, applicationId, roleId], map: "uq_user_app_role")
  @@index([userId], map: "idx_user_app_roles_user")
  @@index([applicationId], map: "idx_user_app_roles_app")
  @@index([userId, applicationId])
  @@map("user_app_roles")
}

// ─── Organizations (OPD / Unit Kerja) ──────────────────────────────────────────
/// Master unit kerja pemerintah lintas aplikasi: OPD, UPTD, biro. Dipakai untuk
/// membatasi data per unit (mis. admin OPD di Lapak hanya melihat OPD-nya).
/// Hierarki lewat parentId (OPD → UPTD).
model Organization {
  id          String           @id @default(uuid(7)) @db.VarChar(36)
  /// Kode singkat stabil, mis. "BPSDM", "BPKPD". Kunci seeder & URL publik.
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(200)
  /// Nama pendek untuk tampilan, mis. "BPSDM".
  shortName   String?          @map("short_name") @db.VarChar(100)
  type        OrganizationType @default(OPD)
  parentId    String?          @map("parent_id") @db.VarChar(36)
  description String?
  address     String?
  phone       String?          @db.VarChar(30)
  email       String?          @db.VarChar(100)
  website     String?          @db.VarChar(255)
  logoUrl     String?          @map("logo_url") @db.VarChar(500)
  logoFileId  String?          @map("logo_file_id") @db.VarChar(100)
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz()

  parent            Organization?             @relation("OrganizationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          Organization[]            @relation("OrganizationTree")
  userAppRoleScopes UserAppRoleOrganization[]
  lapakProducts     LapakProduct[]
  lapakCarts        LapakCart[]
  lapakOrders       LapakOrder[]
  lapakSkrdSettings LapakSkrdSetting[]

  @@index([parentId])
  @@index([type, isActive])
  @@map("organizations")
}

enum OrganizationType {
  OPD
  UPTD
  BIRO
  LAINNYA

  @@map("organization_type")
}

/// Lingkup OPD sebuah penugasan role. Tanpa baris = penugasan berlaku untuk
/// SELURUH OPD. Satu penugasan boleh mencakup banyak OPD.
model UserAppRoleOrganization {
  userAppRoleId  String   @map("user_app_role_id") @db.VarChar(36)
  organizationId String   @map("organization_id") @db.VarChar(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  userAppRole  UserAppRole  @relation(fields: [userAppRoleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userAppRoleId, organizationId])
  @@index([organizationId])
  @@map("user_app_role_organizations")
}

// ─── Refresh Tokens ────────────────────────────────────────────────────────────
/// Penyimpanan hash refresh token untuk pola rotasi JWT.
model RefreshToken {
  id        String   @id @default(uuid(7)) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64) // SHA-256 hex
  appCode   String   @map("app_code") @db.VarChar(50)
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user")
  @@index([expiresAt], map: "idx_refresh_tokens_expires_at")
  @@map("refresh_tokens")
}

// ─── Audit Logs ────────────────────────────────────────────────────────────────
/// Jejak audit tak-termutasi. Diisi worker RabbitMQ — jangan pernah sinkron.
model AuditLog {
  id         String        @id @default(uuid(7)) @db.VarChar(36)
  userId     String?       @map("user_id") @db.VarChar(36)
  appCode    String        @map("app_code") @db.VarChar(50)
  action     String        @db.VarChar(100) // 'user.login', 'article.publish'
  entityType String?       @map("entity_type") @db.VarChar(50)
  entityId   String?       @map("entity_id") @db.VarChar(36)
  metadata   Json?
  ipAddress  String?       @map("ip_address") @db.VarChar(45)
  userAgent  String?       @map("user_agent")
  severity   AuditSeverity @default(INFO)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_audit_logs_user")
  @@index([appCode], map: "idx_audit_logs_app_code")
  @@index([action], map: "idx_audit_logs_action")
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@map("audit_logs")
}

enum AuditSeverity {
  INFO
  WARN
  ERROR
  CRITICAL

  @@map("audit_severity")
}

// ─── Enums Konten & Media ─────────────────────────────────────────────────────
enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED

  @@map("content_status")
}

enum MediaType {
  IMAGE
  VIDEO
  PDF

  @@map("media_type")
}

// ─── Artikel & Berita (Universal Content) ─────────────────────────────────────
/// Jenis konten pada tabel universal articles. Satu jenis = satu route,
/// permission, dan menu sendiri. Tambah nilai baru bila aplikasi butuh jenis
/// konten lain; pengelompokan dalam satu jenis cukup lewat kategori.
enum ArticleType {
  NEWS
  ARTICLE

  @@map("article_type")
}

model ArticleCategory {
  id            String      @id @default(uuid(7)) @db.VarChar(36)
  applicationId String      @map("app_id") @db.VarChar(36)
  type          ArticleType
  name          String      @db.VarChar(100)
  slug          String      @db.VarChar(120)
  description   String?
  isActive      Boolean     @default(true) @map("is_active")
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz()

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  articles    Article[]

  @@unique([applicationId, type, slug], map: "uq_app_article_category_slug")
  @@index([applicationId, type, isActive, sortOrder])
  @@map("article_categories")
}

model Article {
  id              String        @id @default(uuid(7)) @db.VarChar(36)
  applicationId   String        @map("app_id") @db.VarChar(36)
  type            ArticleType
  categoryId      String        @map("category_id") @db.VarChar(36)
  authorId        String        @map("author_id") @db.VarChar(36)
  title           String        @db.VarChar(255)
  slug            String        @db.VarChar(255)
  excerpt         String?       @db.VarChar(1000)
  content         String        @db.Text
  thumbnailUrl    String?       @map("thumbnail_url")
  thumbnailFileId String?       @map("thumbnail_file_id") @db.VarChar(100)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz()
  viewCount       Int           @default(0) @map("view_count")
  seoTitle        String?       @map("seo_title") @db.VarChar(255)
  seoDescription  String?       @map("seo_description") @db.VarChar(500)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz()

  application Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  category    ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author      User            @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([applicationId, type, slug], map: "uq_app_article_slug")
  @@index([applicationId, type, status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@map("articles")
}

// ─── Banner Carousel (Universal Content) ──────────────────────────────────────
model Banner {
  id                String    @id @default(uuid(7)) @db.VarChar(36)
  applicationId     String    @map("app_id") @db.VarChar(36)
  title             String    @db.VarChar(150)
  description       String?
  imageUrl          String    @map("image_url")
  imageFileId       String?   @map("image_file_id") @db.VarChar(100)
  mobileImageUrl    String?   @map("mobile_image_url")
  mobileImageFileId String?   @map("mobile_image_file_id") @db.VarChar(100)
  buttonText        String?   @map("button_text") @db.VarChar(50)
  buttonUrl         String?   @map("button_url") @db.VarChar(255)
  sortOrder         Int       @default(0) @map("sort_order")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz()

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, isActive, sortOrder])
  @@map("banners")
}

// ─── Galeri Multimedia (Universal Content) ────────────────────────────────────
model Gallery {
  id               String        @id @default(uuid(7)) @db.VarChar(36)
  applicationId    String        @map("app_id") @db.VarChar(36)
  authorId         String        @map("author_id") @db.VarChar(36)
  title            String        @db.VarChar(200)
  slug             String        @db.VarChar(220)
