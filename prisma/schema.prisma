  @@unique([applicationId, slug], map: "uq_app_faq_category_slug")
  @@index([applicationId, isActive, sortOrder])
  @@map("faq_categories")
}

model Faq {
  id            String    @id @default(uuid(7)) @db.VarChar(36)
  applicationId String    @map("app_id") @db.VarChar(36)
  categoryId    String    @map("category_id") @db.VarChar(36)
  authorId      String    @map("author_id") @db.VarChar(36)
  updatedById   String?   @map("updated_by_id") @db.VarChar(36)
  question      String    @db.VarChar(500)
  slug          String    @db.VarChar(500)
  answer        String    @db.Text
  sortOrder     Int       @default(0) @map("sort_order")
  isPublished   Boolean   @default(false) @map("is_published")
  viewCount     Int       @default(0) @map("view_count")
