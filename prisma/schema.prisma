  @@unique([applicationId, slug], map: "uq_app_faq_slug")
  @@index([applicationId, categoryId, isPublished])
  @@map("faqs")
}

// ─── UPTD Samsat & Wilayah (Domain Bapenda Jambi) ──────────────────────────────
model BapendaUptd {
  id          String  @id @default(uuid(7)) @db.VarChar(36)
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(150)
  description String?
  address     String?
  phone       String? @db.VarChar(30)
  email       String? @db.VarChar(100)
  headName    String? @map("head_name") @db.VarChar(150)

  // Wilayah Administrasi
  province    String? @default("Jambi") @db.VarChar(50)
  city        String? @db.VarChar(100)
  district    String? @db.VarChar(100)
  subDistrict String? @map("sub_district") @db.VarChar(100)
  postalCode  String? @map("postal_code") @db.VarChar(10)

  // Geolokasi
  latitude      Float?
  longitude     Float?
  googleMapsUrl String? @map("google_maps_url")

  // Visibilitas Publik
  isActive        Boolean @default(true) @map("is_active")
  showOnPublicMap Boolean @default(false) @map("show_on_public_map")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  @@map("bapenda_uptds")
}

// ─── Layanan Operasional Cek Pajak Ranmor (Super App Seloko) ───────────────────
model VehicleTaxCheckLog {
  id           String   @id @default(uuid(7)) @db.VarChar(36)
  userId       String?  @map("user_id") @db.VarChar(36)
  licensePlate String   @map("license_plate") @db.VarChar(20)
  status       String   @db.VarChar(50)
  notes        String?
  latitude     Float?
  longitude    Float?
  locationName String?  @map("location_name") @db.VarChar(255)
