// ─── Lapak: Kategori Layanan (master, dikelola Bapenda) ───────────────────────
/// Delapan kategori layanan aset daerah (PRD 04 §3). Dikelola Bapenda lewat
/// CMS seloko; OPD hanya MEMILIH kategori ini saat membuat produk — tidak
/// pernah membuat sendiri. Satu model Produk nanti mewarisi nilai bawaan
/// atribut tarif/ketersediaan/pemenuhan dari kategorinya.
///
/// Unik per aplikasi (applicationId + slug): bila kelak aplikasi lain memakai
/// modul katalog ini, kategorinya tetap terpisah.
model LapakCategory {
  id                      String    @id @default(uuid(7)) @db.VarChar(36)
  applicationId           String    @map("app_id") @db.VarChar(36)
  name                    String    @db.VarChar(100)
  /// Stabil di URL publik: /lapak/kategori/<slug> dan filter produk.
  slug                    String    @db.VarChar(120)
  description             String?   @db.VarChar(500)
  /// Nama ikon (lucide) untuk kartu kategori di portal.
  icon                    String?   @db.VarChar(50)
  sortOrder               Int       @default(0) @map("sort_order")
  isActive                Boolean   @default(true) @map("is_active")
  /// Nilai bawaan yang diwarisi produk baru pada kategori ini (PRD 04 §3,
  /// keputusan "satu model Produk"). Opsional: Bapenda boleh membiarkan kosong
  /// agar OPD wajib memilih sendiri saat membuat produk.
  defaultPricingUnit      String?   @map("default_pricing_unit") @db.VarChar(20)
  defaultAvailabilityType String?   @map("default_availability_type") @db.VarChar(20)
  defaultFulfillmentType  String?   @map("default_fulfillment_type") @db.VarChar(20)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz() // Soft delete

  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  lapakProducts LapakProduct[]

  @@unique([applicationId, slug], map: "uq_lapak_categories_app_slug")
  @@index([applicationId, isActive], map: "idx_lapak_categories_app_active")
  @@map("lapak_categories")
}

// ─── Lapak: Produk / Aset (katalog, dikelola OPD) ─────────────────────────────
/// Satu model untuk seluruh jenis aset (PRD 04 §3, keputusan "satu model
/// Produk"): gedung, kamar, lahan, tiket rekreasi, kios, alat, jasa lab,
/// hasil usaha. Jenisnya dibedakan kategori + tiga atribut bawaan yang
/// diwarisi dari kategori saat produk dibuat.
///
/// Kepemilikan: WAJIB satu `organizationId` (OPD pemilik) — penjagaan akses
/// per OPD lewat `user_app_role_organizations`, bukan di sini.
///
/// Status memakai enum `ContentStatus` yang sama dengan artikel, demikian
/// pula mesin transisinya (submit/approve/reject/publish/unpublish).
model LapakProduct {
  id                  String        @id @default(uuid(7)) @db.VarChar(36)
  applicationId       String        @map("app_id") @db.VarChar(36)
  organizationId      String        @map("organization_id") @db.VarChar(36)
  categoryId          String        @map("category_id") @db.VarChar(36)
  /// Objek retribusi Perda — opsional dulu, wajib saat SKRD dikerjakan (LJ-2).
  retributionObjectId String?       @map("retribution_object_id") @db.VarChar(36)
  name                String        @db.VarChar(150)
  slug                String        @db.VarChar(180)
  /// Ringkasan untuk kartu katalog & SEO (bisa null; diparaf dari deskripsi).
  excerpt             String?       @db.VarChar(1000)
  description         String        @db.Text
  address             String?       @db.VarChar(255)
  latitude            Decimal?      @db.Decimal(9, 6)
  longitude           Decimal?      @db.Decimal(9, 6)
  /// Kapasitas orang (gedung/kamar/...)
  capacity            Int?
  /// Luas m² (lahan/gedung)
  areaM2              Int?          @map("area_m2")
  pricingUnit         String        @db.VarChar(20)
  availabilityType    String        @map("availability_type") @db.VarChar(20)
  fulfillmentType     String        @map("fulfillment_type") @db.VarChar(20)
  status              ContentStatus @default(DRAFT)
  publishedAt         DateTime?     @map("published_at") @db.Timestamptz()
  /// Slider gambar memakai URL utama sebagai sampul.
  coverUrl            String?       @map("cover_url")
  coverFileId         String?       @map("cover_file_id") @db.VarChar(100)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz()

  application  Application               @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organization Organization              @relation(fields: [organizationId], references: [id])
  category     LapakCategory             @relation(fields: [categoryId], references: [id])
  rates        LapakProductRate[]
  addons       LapakProductAddon[]
  requirements LapakProductRequirement[]
  images       LapakProductImage[]
  facilities   LapakProductFacility[]
  operatingHours LapakOperatingHour[]
  blackoutDates  LapakBlackoutDate[]
  reservations   LapakReservation[]
  cartItems      LapakCartItem[]
  orderItems     LapakOrderItem[]

  @@unique([applicationId, slug], map: "uq_lapak_products_app_slug")
  @@index([applicationId, status], map: "idx_lapak_products_app_status")
  @@index([organizationId, status], map: "idx_lapak_products_org_status")
  @@index([categoryId], map: "idx_lapak_products_category")
  @@map("lapak_products")
}

/// Jam operasional per hari (LJ-2.1). Satu baris per hari yang BUKA.
/// Hari tanpa baris = tutup, sehingga tidak perlu kolom `isOpen` yang bisa
/// bertentangan dengan keberadaan barisnya. `closeTime` boleh lebih kecil dari
/// `openTime` untuk jam lintas tengah malam (mis. 20:00–02:00).
model LapakOperatingHour {
  id        String   @id @default(uuid(7)) @db.VarChar(36)
  productId String   @map("product_id") @db.VarChar(36)
  /// 0 = Minggu … 6 = Sabtu (selaras `Date.getDay()`).
  weekday   Int      @db.SmallInt
  /// Format HH:MM (24 jam) — VARCHAR agar tidak terikat timezone database.
  openTime  String   @map("open_time") @db.VarChar(5)
  closeTime String   @map("close_time") @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  product LapakProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Satu baris per hari per produk — mencegah jadwal ganda yang ambigu.
  @@unique([productId, weekday], map: "uq_lapak_op_hours_product_weekday")
  @@map("lapak_operating_hours")
}

/// Tanggal tutup / maintenance (LJ-2.1). Rentang tanggal, bukan satu hari,
/// karena maintenance sering berlangsung beberapa hari berturut-turut.
model LapakBlackoutDate {
  id        String   @id @default(uuid(7)) @db.VarChar(36)
  productId String   @map("product_id") @db.VarChar(36)
  /// Tanggal mulai (inklusif), disimpan sebagai DATE murni tanpa jam.
  startDate DateTime @map("start_date") @db.Date
  /// Tanggal selesai (inklusif). Sama dengan startDate = tutup satu hari.
  endDate   DateTime @map("end_date") @db.Date
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  product LapakProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, startDate, endDate], map: "idx_lapak_blackout_product_range")
  @@map("lapak_blackout_dates")
}

/// ReservationStatus — siklus hidup satu blok waktu pada produk (LJ-2.2).
enum ReservationStatus {
  /// Blok sementara selama checkout; dibersihkan worker saat `expiresAt` lewat.
  HOLD
  /// Sudah dibayar/dikonfirmasi — blok permanen.
  CONFIRMED
  /// Dibatalkan/dilepas — waktu kembali tersedia.
  RELEASED
}

/// Reservasi rentang waktu produk (PRD 04 §H).
///
/// ANTI DOUBLE-BOOKING DI LEVEL DATABASE, bukan kode aplikasi:
/// exclusion constraint `EXCLUDE USING gist (product_id WITH =, period WITH &&)`
/// membuat dua reservasi yang beririsan untuk produk yang sama MUSTAHIL
/// tersimpan — PostgreSQL menolak transaksi kedua, berapa pun banyaknya request
/// paralel. Kode aplikasi hanya menerjemahkan penolakan itu menjadi 409.
///
/// `period` bertipe `tstzrange` (rentang waktu berzona) sehingga batas atas
/// bisa eksklusif — booking 08:00–10:00 dan 10:00–12:00 tidak dianggap bentrok.
/// `qty` dipakai produk berkuota (mis. kolam renang per orang) yang berbagi
/// slot waktu yang sama; untuk produk unit tunggal nilainya 1.
model LapakReservation {
  id        String   @id @default(uuid(7)) @db.VarChar(36)
  productId String   @map("product_id") @db.VarChar(36)
  /// Rentang waktu blok. Diisi lewat SQL mentah (Prisma belum punya tipe range).
  /// Tidak dipakai di klien Prisma — baca lewat `startAt`/`endAt` turunan.
  period    Unsupported("tstzrange") @map("period")
  /// Salinan batas rentang untuk pembacaan mudah & sortir (dijaga trigger/insert).
  startAt   DateTime @map("start_at") @db.Timestamptz()
  endAt     DateTime @map("end_at") @db.Timestamptz()
  /// Jumlah unit yang diblok (kuota). Unit tunggal = 1.
  qty       Int      @default(1)
  status    ReservationStatus @default(HOLD)
  /// Kapan HOLD kedaluwarsa; worker melepasnya. NULL untuk CONFIRMED.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz()
  /// Pemesan (user PUBLIC) — nullable selama keranjang belum terikat akun.
  userId    String?  @map("user_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  product LapakProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  cartItem  LapakCartItem?
  orderItem LapakOrderItem?

  @@index([productId, status], map: "idx_lapak_reservations_product_status")
  @@index([expiresAt], map: "idx_lapak_reservations_expires")
  @@map("lapak_reservations")
}

/// Keranjang belanja warga (LJ-2.3, PRD 04 §4.F).
///
/// SATU KERANJANG PER (user, OPD). Warga boleh punya beberapa keranjang —
/// satu untuk tiap OPD — karena SKRD diterbitkan per penerbit sehingga
/// checkout lintas OPD dipecah menjadi beberapa pesanan. Aturan "satu pesanan
/// = satu OPD" ditegakkan di sini lewat unique index, bukan dicek manual:
/// memasukkan produk OPD lain ke keranjang yang sudah ada akan ditolak DB.
///
/// Keranjang sengaja TIDAK menyimpan harga: harga diambil dari tarif aktif
/// saat quote/checkout (LJ-2.4) dan dibekukan sebagai snapshot di pesanan.
/// Menyimpan harga di keranjang berarti harga basi bisa ikut ter-checkout.
model LapakCart {
  id             String   @id @default(uuid(7)) @db.VarChar(36)
  userId         String   @map("user_id") @db.VarChar(36)
  organizationId String   @map("organization_id") @db.VarChar(36)
  applicationId  String   @map("app_id") @db.VarChar(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization          @relation(fields: [organizationId], references: [id])
  application  Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  items        LapakCartItem[]

  /// Kunci aturan §4.F: satu keranjang per user per OPD.
  @@unique([userId, organizationId], map: "uq_lapak_carts_user_org")
  @@index([userId], map: "idx_lapak_carts_user")
  @@map("lapak_carts")
}

/// Satu baris barang di keranjang.
///
/// `reservationId` menautkan blok waktu yang sudah di-HOLD (LJ-2.2) ke baris
/// keranjang. Bila keranjang ditinggalkan, HOLD kedaluwarsa sendiri lewat
/// `expiresAt` — baris keranjang tidak perlu ikut dihapus.
model LapakCartItem {
  id            String   @id @default(uuid(7)) @db.VarChar(36)
  cartId        String   @map("cart_id") @db.VarChar(36)
  productId     String   @map("product_id") @db.VarChar(36)
  /// Tarif yang dipilih; NULL = pakai tarif termurah saat quote.
  rateId        String?  @map("rate_id") @db.VarChar(36)
  /// Reservasi HOLD yang menahan slot untuk baris ini (opsional).
  reservationId String?  @unique @map("reservation_id") @db.VarChar(36)
  qty           Int      @default(1)
  /// Rentang waktu yang dipilih (untuk produk bertipe SLOT/DATE_RANGE).
  startAt       DateTime? @map("start_at") @db.Timestamptz()
  endAt         DateTime? @map("end_at") @db.Timestamptz()
  /// Catatan pemohon untuk baris ini.
  note          String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  cart        LapakCart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     LapakProduct      @relation(fields: [productId], references: [id])
  rate        LapakProductRate? @relation(fields: [rateId], references: [id])
  reservation LapakReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([cartId], map: "idx_lapak_cart_items_cart")
  @@index([productId], map: "idx_lapak_cart_items_product")
  @@map("lapak_cart_items")
}

/// Status pesanan (PRD 04 §5). Alur lengkap; modul ini baru memakai
/// DRAFT → MENUNGGU_PEMBAYARAN. Sisanya dipakai SKRD/pembayaran/tiket.
enum OrderStatus {
  DRAFT
  /// Butuh persetujuan OPD sebelum SKRD terbit.
  MENUNGGU_VERIFIKASI
  /// SKRD terbit; warga harus membayar sebelum `expiresAt`.
  MENUNGGU_PEMBAYARAN
  /// Bukti transfer diunggah, menunggu konfirmasi OPD.
  MENUNGGU_KONFIRMASI
  LUNAS
  /// Tiket/kontrak sedang dipakai.
  AKTIF
  SELESAI
  DITOLAK
  DIBATALKAN
  KEDALUWARSA
  REFUND
}

/// Satu pesanan = satu OPD (PRD 04 §4.F).
///
/// SNAPSHOT ADALAH INTI MODEL INI:
/// - `applicant` menyimpan data pemohon apa adanya saat checkout (PII) —
///   wajib dimasking di list & log, lihat security-guidelines.md.
/// - Tiap baris menyimpan nama/harga/satuan hasil salinan dari tarif saat itu.
///   Bila Bapenda mengubah tarif besok, pesanan kemarin TIDAK boleh berubah.
///
/// `code` unik per aplikasi dan dipakai warga untuk melacak pesanan; dibuat
/// dari tanggal + urutan acak agar tidak mudah ditebak.
model LapakOrder {
  id             String      @id @default(uuid(7)) @db.VarChar(36)
  code           String      @db.VarChar(40)
  applicationId  String      @map("app_id") @db.VarChar(36)
  userId         String      @map("user_id") @db.VarChar(36)
  organizationId String      @map("organization_id") @db.VarChar(36)
  status         OrderStatus @default(DRAFT)
  /// Snapshot data pemohon (nama, NIK, NPWP, instansi, telepon, alamat).
  /// PII — jangan pernah dikirim utuh ke publik.
  applicant      Json
  /// Maksud/tujuan pemakaian.
  purpose        String?     @db.VarChar(500)
  /// Subtotal & total dalam rupiah utuh (bukan desimal) — retribusi tidak
  /// memakai pecahan, dan menyimpan integer menghindari galat pembulatan.
  subtotal       Int
  total          Int
  /// Batas waktu pembayaran; lewat dari ini pesanan kedaluwarsa (worker).
  expiresAt      DateTime?   @map("expires_at") @db.Timestamptz()
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  application  Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id])
  organization Organization    @relation(fields: [organizationId], references: [id])
  items        LapakOrderItem[]
  statusLogs   LapakOrderStatusLog[]
  skrd         LapakSkrd?
  payments     LapakPayment[]

  /// Kode pesanan unik per aplikasi — dipakai warga untuk melacak.
  @@unique([applicationId, code], map: "uq_lapak_orders_app_code")
  @@index([userId, status], map: "idx_lapak_orders_user_status")
  @@index([organizationId, status], map: "idx_lapak_orders_org_status")
  @@index([expiresAt], map: "idx_lapak_orders_expires")
  @@map("lapak_orders")
}

/// Baris pesanan — SNAPSHOT harga, bukan referensi hidup ke tarif.
model LapakOrderItem {
  id            String   @id @default(uuid(7)) @db.VarChar(36)
  orderId       String   @map("order_id") @db.VarChar(36)
  productId     String   @map("product_id") @db.VarChar(36)
  /// Tarif asal; boleh null bila tarifnya kelak dihapus.
  rateId        String?  @map("rate_id") @db.VarChar(36)
  /// Reservasi yang dikonfirmasi untuk baris ini.
  reservationId String?  @unique @map("reservation_id") @db.VarChar(36)
  /// Salinan nama & satuan saat checkout — produk bisa berganti nama nanti.
  productName   String   @map("product_name") @db.VarChar(150)
  rateName      String   @map("rate_name") @db.VarChar(100)
  unit          String   @db.VarChar(20)
  /// Harga satuan saat checkout (snapshot).
  price         Int
  qty           Int
  /// Harga × qty, dibekukan agar pembulatan tidak berubah di kemudian hari.
  lineTotal     Int      @map("line_total")
  startAt       DateTime? @map("start_at") @db.Timestamptz()
  endAt         DateTime? @map("end_at") @db.Timestamptz()
  note          String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  order       LapakOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     LapakProduct      @relation(fields: [productId], references: [id])
  rate        LapakProductRate? @relation(fields: [rateId], references: [id])
  reservation LapakReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  ticket      LapakTicket?

  @@index([orderId], map: "idx_lapak_order_items_order")
  @@map("lapak_order_items")
}

/// Jejak audit perubahan status pesanan — siapa, kapan, dari apa ke apa.
model LapakOrderStatusLog {
  id        String      @id @default(uuid(7)) @db.VarChar(36)
  orderId   String      @map("order_id") @db.VarChar(36)
  fromStatus OrderStatus? @map("from_status")
  toStatus  OrderStatus @map("to_status")
  /// Pelaku; null bila perubahan oleh sistem (worker kedaluwarsa).
  actorId   String?     @map("actor_id") @db.VarChar(36)
  note      String?     @db.VarChar(500)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  order LapakOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt], map: "idx_lapak_order_logs_order_time")
  @@map("lapak_order_status_logs")
}

/// Penerbit SKRD (PRD 04 §D). Bapenda atau OPD itu sendiri.
enum SkrdIssuer {
  BAPENDA
  OPD
}

enum SkrdDocumentType {
  SKRD
  /// "Dokumen Transaksi (dipersamakan SKRD)" — kategori 8 penjualan hasil usaha.
  DIPERSAMAKAN
}

enum SkrdStatus {
  /// Terbit & menunggu pembayaran.
  TERBIT
  LUNAS
  /// Pesanan dibatalkan/kedaluwarsa. Nomor TIDAK dipakai ulang (gapless).
  CANCELLED
}

/// Pengaturan penerbitan SKRD (PRD 04 §D).
///
/// `organizationId = null` adalah baris DEFAULT (Bapenda) — dipakai bila OPD
/// belum punya pengaturan sendiri. Tingkat kekhususan: OPD > default.
///
/// `numberFormat` adalah template; token yang dikenali:
/// `{seq}` urutan, `{seq6}` urutan 6 digit, `{issuer}`, `{romanMonth}`,
/// `{month}`, `{year}`, `{orgCode}`.
model LapakSkrdSetting {
  id             String     @id @default(uuid(7)) @db.VarChar(36)
  applicationId  String     @map("app_id") @db.VarChar(36)
  /// NULL = pengaturan default (Bapenda).
  organizationId String?    @map("organization_id") @db.VarChar(36)
  issuer         SkrdIssuer
  /// Template nomor, mis. "{seq6}/SKRD/{issuer}/{romanMonth}/{year}".
  numberFormat   String     @map("number_format") @db.VarChar(200)
  /// Penandatangan — disalin sebagai snapshot ke tiap SKRD saat terbit.
  signerName     String     @map("signer_name") @db.VarChar(150)
  signerNip      String?    @map("signer_nip") @db.VarChar(30)
  signerPosition String?    @map("signer_position") @db.VarChar(150)
  /// Rekening tujuan (RKUD).
  bankName       String?    @map("bank_name") @db.VarChar(100)
  bankAccount    String?    @map("bank_account") @db.VarChar(50)
  bankHolder     String?    @map("bank_holder") @db.VarChar(150)
  /// Jatuh tempo pembayaran (hari) sejak terbit.
  dueDays        Int        @default(7) @map("due_days")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  application  Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Satu pengaturan per (aplikasi, OPD) — termasuk baris default (null).
  @@unique([applicationId, organizationId], map: "uq_lapak_skrd_settings_app_org")
  @@map("lapak_skrd_settings")
}

/// Penomoran gapless per (penerbit, tahun) — PRD 04 §D.
///
/// GAUNTLESS DIMAKSUD DI SINI: nomor yang terbit berurutan tanpa lompat, dan
/// nomor yang sudah dipakai TIDAK PERNAH dipakai ulang meski SKRD-nya
/// dibatalkan. Karena itu `lastNumber` hanya pernah NAIK.
///
/// Kunci baris (`SELECT ... FOR UPDATE`) di dalam transaksi yang sama dengan
/// penerbitan SKRD mencegah dua checkout bersamaan memperoleh nomor yang sama.
/// `INSERT` sequence dilakukan SETELAH order tersimpan, dalam transaksi yang
/// sama, sehingga bila penerbitan SKRD gagal seluruhnya rollback — nomor tidak
/// terbuang (lubang nomor = temuan audit).
model LapakSkrdSequence {
  id        String   @id @default(uuid(7)) @db.VarChar(36)
  /// Kunci penerbit: "BAPENDA" atau kode OPD. Disimpan sebagai teks agar
  /// sequence tetap bisa ditelusuri walau baris OPD berubah kode.
  issuerKey String   @map("issuer_key") @db.VarChar(60)
  year      Int
  lastNumber Int     @default(0) @map("last_number")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([issuerKey, year], map: "uq_lapak_skrd_seq_issuer_year")
  @@map("lapak_skrd_sequences")
}

/// SKRD / Dokumen dipersamakan SKRD (PRD 04 §D).
///
/// Menerbitkan SKRD = tindakan hukum; karena itu seluruh isinya disalin sebagai
/// SNAPSHOT (penerbit, penandatangan, rekening, jumlah). Bila pengaturan SKRD
/// diubah besok, dokumen yang sudah terbit TIDAK berubah.
///
/// `qrToken` unik dipakai halaman verifikasi publik untuk memastikan dokumen
/// yang ditunjukkan warga memang asli terbit dari sistem ini.
model LapakSkrd {
  id             String           @id @default(uuid(7)) @db.VarChar(36)
  orderId        String           @unique @map("order_id") @db.VarChar(36)
  number         String           @db.VarChar(100)
  documentType   SkrdDocumentType @default(SKRD) @map("document_type")
  issuer         SkrdIssuer
  /// Snapshot penerbit: kode & nama OPD (atau Bapenda bila issuer=BAPENDA).
  issuerCode     String           @map("issuer_code") @db.VarChar(50)
  issuerName     String           @map("issuer_name") @db.VarChar(150)
  /// Snapshot penandatangan & rekening — TIDAK mengikuti perubahan setting.
  signerName     String           @map("signer_name") @db.VarChar(150)
  signerNip      String?          @map("signer_nip") @db.VarChar(30)
  signerPosition String?          @map("signer_position") @db.VarChar(150)
  bankName       String?          @map("bank_name") @db.VarChar(100)
  bankAccount    String?          @map("bank_account") @db.VarChar(50)
  bankHolder     String?          @map("bank_holder") @db.VarChar(150)
  amount         Int
  issuedAt       DateTime         @map("issued_at") @db.Timestamptz()
  dueAt          DateTime         @map("due_at") @db.Timestamptz()
  status         SkrdStatus       @default(TERBIT)
  /// Token verifikasi publik — acak, tidak bisa ditebak dari nomor.
  qrToken        String           @unique @map("qr_token") @db.VarChar(64)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  order LapakOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Nomor unik per penerbit per tahun — dua SKRD tak boleh bernomor sama.
  @@unique([issuerCode, number], map: "uq_lapak_skrds_issuer_number")
  @@index([status, dueAt], map: "idx_lapak_skrds_status_due")
  @@map("lapak_skrds")
}

/// Metode & status pembayaran (PRD 04 §E).
enum PaymentMethod {
  /// Fase awal: transfer bank + unggah bukti.
  MANUAL_TRANSFER
  /// Disiapkan untuk gateway (Bank Jambi VA/QRIS) — belum dipakai.
  VIRTUAL_ACCOUNT
  QRIS
}

enum PaymentStatus {
  /// Menunggu bukti transfer diunggah.
  MENUNGGU_BUKTI
  /// Bukti sudah diunggah, menunggu konfirmasi OPD.
  MENUNGGU_KONFIRMASI
  LUNAS
  DITOLAK
  KEDALUWARSA
}

/// Pembayaran sebuah pesanan (PRD 04 §E).
///
/// Kolom gateway (`provider`, `vaNumber`, `qrisPayload`, `externalRef`,
/// `rawCallback`) sudah ada sejak awal supaya integrasi Bank Jambi nanti hanya
/// menambah adapter — bukan migrasi besar.
///
/// Satu pesanan boleh punya BEBERAPA baris pembayaran: bukti yang ditolak
/// membuat warga mengunggah ulang, dan riwayatnya harus tetap utuh untuk audit.
model LapakPayment {
  id         String        @id @default(uuid(7)) @db.VarChar(36)
  orderId    String        @map("order_id") @db.VarChar(36)
  method     PaymentMethod @default(MANUAL_TRANSFER)
  status     PaymentStatus @default(MENUNGGU_BUKTI)
  amount     Int
  /// Bukti transfer (ImageKit). `proofUrl` untuk ditampilkan, `proofFileId`
  /// untuk menghapus berkas bila perlu.
  proofUrl   String?       @map("proof_url") @db.VarChar(500)
  proofFileId String?      @map("proof_file_id") @db.VarChar(200)
  /// Catatan dari warga saat mengunggah bukti.
  note       String?       @db.VarChar(500)
  /// Alasan penolakan oleh OPD.
  rejectReason String?     @map("reject_reason") @db.VarChar(500)
  /// Nama pengirim sesuai mutasi bank — dipakai OPD mencocokkan.
  senderName String?       @map("sender_name") @db.VarChar(150)
  senderBank String?       @map("sender_bank") @db.VarChar(100)
  paidAt     DateTime?     @map("paid_at") @db.Timestamptz()
  /// Konfirmasi oleh admin OPD.
  confirmedBy String?      @map("confirmed_by") @db.VarChar(36)
  confirmedAt DateTime?    @map("confirmed_at") @db.Timestamptz()
  // ─── Kolom gateway (disiapkan, belum dipakai fase awal) ─────────────────────
  provider   String?       @db.VarChar(50)
  vaNumber   String?       @map("va_number") @db.VarChar(50)
  qrisPayload String?      @map("qris_payload") @db.Text
  externalRef String?      @map("external_ref") @db.VarChar(120)
  rawCallback Json?        @map("raw_callback")
  expiresAt  DateTime?     @map("expires_at") @db.Timestamptz()
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  order LapakOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status], map: "idx_lapak_payments_order_status")
  @@index([status, expiresAt], map: "idx_lapak_payments_status_expires")
  @@map("lapak_payments")
}

/// Jenis tiket (PRD 04 §3). Mengikuti `fulfillmentType` produk:
/// TICKET_QR → TICKET, BOOKING → BOOKING, CONTRACT → CONTRACT,
/// RESULT → RESULT. HANDOVER = serah terima barang, SCHEDULE = jadwal.
enum TicketKind {
  /// Sekali masuk, discan di pintu (kolam renang, GOR).
  TICKET
  /// Bukti pemesanan berdurasi (aula, asrama) — check-in lalu check-out.
  BOOKING
  /// Kontrak sewa (kendaraan, alat berat).
  CONTRACT
  /// Serah terima barang.
  HANDOVER
  /// Hasil layanan (hasil laboratorium, sertifikat).
  RESULT
  /// Jadwal kunjungan berulang.
  SCHEDULE
}

enum TicketStatus {
  /// Terbit setelah pesanan LUNAS, siap dipakai.
  AKTIF
  /// Sudah discan/di-check-in.
  DIGUNAKAN
  /// Kedaluwarsa karena masa berlaku lewat.
  KEDALUWARSA
  /// Dibatalkan (pesanan dibatalkan/refund).
  DIBATALKAN
}

/// Tiket / bukti pemenuhan per BARIS pesanan (PRD 04 §3 & §5).
///
/// Terbit **SAAT LUNAS**, bukan saat checkout: tiket adalah bukti hak pakai, dan
/// hak itu baru sah setelah dibayar. Menerbitkan lebih awal berarti warga bisa
/// masuk tanpa membayar.
///
/// Satu baris pesanan = satu tiket. `qrToken` unik dipakai petugas lokasi untuk
/// memvalidasi; `code` adalah kode pendek yang bisa dibacakan manual bila QR
/// rusak.
model LapakTicket {
  id            String       @id @default(uuid(7)) @db.VarChar(36)
  orderItemId   String       @unique @map("order_item_id") @db.VarChar(36)
  kind          TicketKind
  /// Kode pendek yang bisa dibacakan manual, mis. "TKT-7K2M9P".
  code          String       @db.VarChar(40)
  /// Token QR acak — tidak bisa diturunkan dari kode.
  qrToken       String       @unique @map("qr_token") @db.VarChar(64)
  status        TicketStatus @default(AKTIF)
  /// Masa berlaku: diisi dari rentang pesanan, atau jatuh tempo + tenggang.
  validFrom     DateTime?    @map("valid_from") @db.Timestamptz()
  validUntil    DateTime?    @map("valid_until") @db.Timestamptz()
  /// Kapan benar-benar dipakai & oleh siapa.
  usedAt        DateTime?    @map("used_at") @db.Timestamptz()
  checkedInBy   String?      @map("checked_in_by") @db.VarChar(36)
  /// Snapshot: perubahan produk/pesanan tidak mengubah tiket yang sudah terbit.
  productName   String       @map("product_name") @db.VarChar(150)
  rateName      String       @map("rate_name") @db.VarChar(100)
  organizationId String      @map("organization_id") @db.VarChar(36)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  orderItem LapakOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  /// Kode unik per aplikasi — dipakai petugas membacakan/mencari tiket.
  @@unique([organizationId, code], map: "uq_lapak_tickets_org_code")
  @@index([status, validUntil], map: "idx_lapak_tickets_status_valid")
  @@map("lapak_tickets")
}

/// Tarif per sesi/satuan. Punya status sendiri (PRD 04 §C): mengubah tarif
/// produk TERBIT tidak menurunkan produk — buat baris baru ber-status
/// DRAFT/PENDING_REVIEW, publik hanya melihat APPROVED/PUBLISHED aktif,
/// pesanan menyimpan snapshot harga.
model LapakProductRate {
  id            String        @id @default(uuid(7)) @db.VarChar(36)
  productId     String        @map("product_id") @db.VarChar(36)
  name          String        @db.VarChar(100)
  /// Satuan tarif baris ini — boleh beda dari satuan produk (mis. paket).
  unit          String        @db.VarChar(20)
  price         Decimal       @db.Decimal(14, 2)
  minQty        Int           @default(1) @map("min_qty")
  maxQty        Int?          @map("max_qty")
  /// Batas jam untuk sesi (Siang/Malam) — null untuk satuan hari/bulan.
  startTime     String?       @map("start_time") @db.VarChar(5)
  endTime       String?       @map("end_time") @db.VarChar(5)
  status        ContentStatus @default(DRAFT)
  /// Mulai berlaku — publik memakai baris APPROVED dengan effectiveFrom terbaru.
  effectiveFrom DateTime      @default(now()) @map("effective_from") @db.Timestamptz()
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz()

  product   LapakProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  LapakCartItem[]
  orderItems LapakOrderItem[]

  @@index([productId, status], map: "idx_lapak_product_rates_product_status")
  @@map("lapak_product_rates")
}

/// Layanan tambahan (proyektor, katering, sound system).
model LapakProductAddon {
  id        String    @id @default(uuid(7)) @db.VarChar(36)
  productId String    @map("product_id") @db.VarChar(36)
  name      String    @db.VarChar(100)
  unit      String    @db.VarChar(20)
  price     Decimal   @db.Decimal(14, 2)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  product LapakProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "idx_lapak_product_addons_product")
  @@map("lapak_product_addons")
}

/// Persyaratan pemesanan: dokumen yang diunggah atau isian warga.
model LapakProductRequirement {
  id         String    @id @default(uuid(7)) @db.VarChar(36)
  productId  String    @map("product_id") @db.VarChar(36)
  label      String    @db.VarChar(150)
  /// FILE | TEXT | NUMBER | DATE | SELECT — VARCHAR longgar, kontrak ketat di Zod.
  fieldType  String    @map("field_type") @db.VarChar(20)
  /// Pilihan untuk SELECT: JSON array string.
  options    Json?
  isRequired Boolean   @default(true) @map("is_required")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz()

  product LapakProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "idx_lapak_product_reqs_product")
  @@map("lapak_product_requirements")
}

/// Gambar produk (ImageKit two-step seperti Banner).
model LapakProductImage {
  id        String    @id @default(uuid(7)) @db.VarChar(36)
  productId String    @map("product_id") @db.VarChar(36)
  url       String    @db.VarChar(500)
  fileId    String?   @map("file_id") @db.VarChar(100)
  altText   String?   @map("alt_text") @db.VarChar(150)
  isPrimary Boolean   @default(false) @map("is_primary")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  product LapakProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "idx_lapak_product_images_product")
  @@map("lapak_product_images")
}

/// Fasilitas yang tersedia (wifi, parkir, AC, ...).
model LapakProductFacility {
  id        String    @id @default(uuid(7)) @db.VarChar(36)
  productId String    @map("product_id") @db.VarChar(36)
  name      String    @db.VarChar(100)
  icon      String?   @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  product LapakProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "idx_lapak_product_facilities_product")
  @@map("lapak_product_facilities")
}
