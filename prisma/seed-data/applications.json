{
  "$comment": "Aplikasi terdaftar + permission per aplikasi. entity+action menyusun kode permission '<entity>:<action>' yang dicek requirePermission(). 'actions' boleh memakai nama grup dari roles.json (mis. 'content', 'publishable') atau aksi tunggal.",
  "applications": [
    {
      "code": "seloko",
      "name": "SELOKO CMS",
      "description": "Konsol manajemen terpusat Bapenda Jambi",
      "isActive": true,
      "permissions": [
        { "module": "Pengguna", "entity": "user", "label": "Pengguna", "actions": ["content"] },
        { "module": "Akses", "entity": "role", "label": "Role", "actions": ["content"] },
        { "module": "Akses", "entity": "permission", "label": "Permission", "actions": ["read", "list"] },
        { "module": "Akses", "entity": "user-app-role", "label": "Penugasan Role", "actions": ["create", "list", "delete"] },
        { "module": "Sistem", "entity": "application", "label": "Aplikasi", "actions": ["content"] },
        { "module": "Sistem", "entity": "audit-log", "label": "Log Audit", "actions": ["read", "list", "export"] }
      ]
    },
    {
      "code": "bapenda-profile",
      "name": "Bapenda Profile Portal",
      "description": "Portal profil dan informasi publik Bapenda Jambi",
      "isActive": true,
      "permissions": [
        { "module": "Konten", "entity": "article", "label": "Artikel", "actions": ["publishable"] },
        { "module": "Konten", "entity": "announcement", "label": "Pengumuman", "actions": ["publishable"] },
        { "module": "Media", "entity": "banner", "label": "Banner", "actions": ["content"] },
        { "module": "Media", "entity": "gallery", "label": "Galeri", "actions": ["content"] }
      ]
    },
    {
      "code": "lapak-jambi-web",
      "name": "Lapak Jambi Web",
      "description": "Marketplace UMKM Jambi — antarmuka web",
      "isActive": true,
      "permissions": [
        { "module": "Mitra", "entity": "merchant", "label": "Merchant", "actions": ["verifiable"] },
        { "module": "Katalog", "entity": "product", "label": "Produk", "actions": ["verifiable"] },
        { "module": "Katalog", "entity": "category", "label": "Kategori", "actions": ["content"] },
        { "module": "Transaksi", "entity": "order", "label": "Pesanan", "actions": ["read", "list", "update", "export"] }
      ]
    },
    {
      "code": "lapak-jambi-app",
      "name": "Lapak Jambi Mobile",
      "description": "Marketplace UMKM Jambi — aplikasi mobile",
      "isActive": true,
      "permissions": [
        { "module": "Mitra", "entity": "merchant", "label": "Merchant", "actions": ["read", "list", "update"] },
        { "module": "Katalog", "entity": "product", "label": "Produk", "actions": ["content"] },
        { "module": "Transaksi", "entity": "order", "label": "Pesanan", "actions": ["read", "list", "update"] }
      ]
    },
    {
      "code": "seloko-nonaktif",
      "name": "Aplikasi Uji Nonaktif",
      "description": "Sengaja isActive=false — untuk menguji penolakan login pada aplikasi yang dimatikan",
      "isActive": false,
      "permissions": [
        { "module": "Sistem", "entity": "dummy", "label": "Dummy", "actions": ["read", "list"] }
      ]
    }
  ]
}
