# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://seloko_user:seloko_pass@localhost:5432/seloko_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=seloko:

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://seloko_user:seloko_pass@localhost:5672
RABBITMQ_EXCHANGE=seloko.exchange
RABBITMQ_PREFETCH=10

# ─── JWT (min 32 chars!) ──────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Cookie (min 32 chars!) ───────────────────────────────────────────────────
COOKIE_SECRET=change_this_to_a_very_long_random_secret_min_32_chars

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins, or * for all
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
